{
  "name": "computer-doctor-cli",
  "version": "0.1.0",
  "description": "Cross-platform CLI framework for computer repair technicians",
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "bin": {
    "computer-doctor": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "mvp": "tsx src/index.tsx run",
    "pack:exe": "pnpm dlx pkg . --targets node22-win-x64,node22-linux-x64,node22-macos-x64 --output dist/computer-doctor"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.22",
    "ai": "^6.0.184",
    "commander-jsx": "^0.7.3",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.29",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
